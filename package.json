{
  "name": "pai",
  "version": "0.0.1",
  "description": "OpenAI-compatible gateway that drives AI chat web UIs with Playwright ;)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/cli.ts serve",
    "serve": "tsx src/cli.ts serve",
    "auth": "tsx src/cli.ts auth",
    "providers": "tsx src/cli.ts list",
    "mock:ia-1": "tsx mock/ia-1/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
