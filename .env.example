# --- HTTP server ---
HOST=127.0.0.1
PORT=3000
# If set, every /v1 request must send "Authorization: Bearer <key>". Always set it when HOST is not loopback.
PAI_API_KEY=

# --- Storage (browser profiles + session cache) ---
PAI_DATA_DIR=.pai

# --- Browser ---
PAI_HEADLESS=true
# Optional: use an installed browser ("chrome", "msedge") instead of bundled Chromium.
PAI_BROWSER_CHANNEL=
# Close an idle browser profile after this many ms (also releases the profile lock).
PAI_CONTEXT_IDLE_MS=300000

# --- Scraping timings ---
PAI_RESPONSE_TIMEOUT_MS=120000
PAI_NAVIGATION_TIMEOUT_MS=20000
# The answer is considered finished when its text did not change for this long.
PAI_STABLE_MS=1500
PAI_POLL_MS=250

# --- Conversation handling ---
# Max characters of history replayed in a continuation prompt.
PAI_MAX_HISTORY_CHARS=60000
PAI_SESSION_TTL_HOURS=168

PAI_LOG_LEVEL=info

# --- ia-1 target ---
# Local mock site (run it with: pnpm mock:ia-1). Empty = the placeholder https://ia-1.example.com.
PAI_IA1_BASE_URL=http://127.0.0.1:4010

# --- Mock site (mock/ia-1) ---
# MOCK_HOST=127.0.0.1
# MOCK_PORT=4010
# MOCK_THINKING_MS=900
# MOCK_TOKEN_MS=45